// ~/.config/tmux/tmup.kdl
// tmup configuration — KDL v2 syntax

options {
    auto-install #true
    concurrency 16
}

// Simplest form: GitHub shorthand, track default branch
plug "tmux-plugins/tmux-sensible"

// Pin to a tag — update will skip this plugin
plug "tmux-plugins/tmux-yank" tag="v2.3"

// Full config: branch + build + opts
plug "tmux-plugins/tmux-resurrect" branch="master" build="make install" {
    opt "resurrect-strategy-vim" "session"
    opt "resurrect-save-bash-history" "on"
}

// opt-prefix reduces repetition
plug "catppuccin/tmux" opt-prefix="catppuccin_" {
    opt "flavor" "mocha"
    opt "window_text" "#W"
}

// Non-GitHub source
plug "https://gitlab.com/user/my-plugin.git"

// Local plugin: loaded in-place, not managed by lock
plug "~/dev/my-tmux-plugin" local=#true name="my-plugin-dev"

// Disable a plugin with KDL slashdash
/-plug "tmux-plugins/tmux-continuum"
